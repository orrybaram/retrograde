[gd_resource type="Resource" script_class="RadioConversation" format=3]

[ext_resource type="Script" path="res://entities/Robot/radio/RadioConversation.gd" id="1_conv"]
[ext_resource type="Script" path="res://entities/Robot/radio/RadioLine.gd" id="2_line"]

[sub_resource type="Resource" id="line_1"]
script = ExtResource("2_line")
text = "There you are. Took a while this time."
expression = &"hello"

[sub_resource type="Resource" id="line_2"]
script = ExtResource("2_line")
text = "Systems look good. You feeling okay?"
expression = &"happy"

[sub_resource type="Resource" id="line_3"]
script = ExtResource("2_line")
text = "..."
expression = &"neutral"

[sub_resource type="Resource" id="line_4"]
script = ExtResource("2_line")
text = "Anyway. There's scrap out there. Always is."
expression = &"happy"

[sub_resource type="Resource" id="line_5"]
script = ExtResource("2_line")
text = "Debris ring hugging Rook, just inside our orbit. Worth a look."
expression = &"wink"

[resource]
script = ExtResource("1_conv")
id = &"first_wake"
priority = 1
once = true
pause_game = true
lines = Array[ExtResource("2_line")]([SubResource("line_1"), SubResource("line_2"), SubResource("line_3"), SubResource("line_4"), SubResource("line_5")])
