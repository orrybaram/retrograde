# The end of Act 1 (docs/OPENING.md §5): a new game wakes adrift outside SR-7, whose dock's
# arm is in. Every piece home, the core's aux strips catch and, on that battery, the arm
# runs out and locks and the dock's lamps light. Docking there is met by the station's own
# console: REBOOT CORE, and the core clunks home, the slots catch, the power comes up from
# it, the dish pings, and UNIT-7 comes on the comms.
# Run: PLAYTEST_PORT=7794 tools/play.sh --headless playtests/core_cold_start.play

press enter
wait_until main.current_game_state == 1 and not get_tree().paused 15
assert pt.state_name() == "FlyingState" "a new game wakes adrift"
assert not get_tree().root.get_node("RobotRadio").guide_awake "nobody on the comms on a new game"
assert not pt.arm().out "SR-7's dock arm is in"
assert not pt.arm().get_port().accepts_docking() "so there is nowhere to dock"
assert not pt.core().listens() "a broken station's core hears nothing"

# --- Whole: the aux strips catch, then the arm runs out on that battery ---
eval pt.seat_sr7(true)
wait 0.3
assert pt.core().listens() "every piece home: the core is on standby"
assert pt.arm().is_extending() "the arm is on its way"
assert not pt.arm().get_port().accepts_docking() "no docking until it locks"
eval pt.park_by_core(Vector2(420, 260))
wait 1.5
assert pt.core().aux_level() == 1.0 "the bay's aux strips are up first"
wait 2.0
screenshot arm_1_running
wait_until pt.arm().out 8
assert pt.arm().get_port().accepts_docking() "locked out: the dock takes a ship"
assert not get_tree().get_first_node_in_group("station_power").powered "and the station is still dark"
wait 0.8
screenshot arm_2_out

# --- Docking is met by the console, not the hub ---
eval pt.redock()
wait_until pt.visible_ui().has("CoreTerminal") 3
assert pt.state_name() == "LandedState" "docked"
assert not pt.visible_ui().has("SpacePortDialogue") "nobody is running the port"
assert str(pt.screen_text().get("CoreTerminal", [])).contains("REBOOT CORE") "the one thing it can do"
screenshot terminal_1

# ESC leaves the console; the action key brings it back
press escape
wait_until not pt.visible_ui().has("CoreTerminal") 2
assert pt.state_name() == "LandedState" "still docked"
press action
wait_until pt.visible_ui().has("CoreTerminal") 2

# --- REBOOT CORE ---
press enter
wait 0.6
screenshot terminal_2_log
wait_until pt.core().is_starting() 8
assert not pt.visible_ui().has("CoreTerminal") "the console steps aside for the wake"
wait_until pt.core().started 6
assert get_tree().get_first_node_in_group("game_state").core_started "the core is running"
assert get_tree().get_first_node_in_group("station_power").powered "power comes up from the core"
assert pt.core().get_parent().get_node("Lights").is_waking() "the lights catch one by one"
assert pt.state_name() == "LandedState" "watched from the dock"
screenshot core_3_catching
wait_until not pt.core().get_parent().get_node("Lights").is_waking() 15
wait_until pt.core().get_parent().get_node("Visuals/KeelLower/CommDish").get_node_or_null("Ping") != null 20
assert pt.core().get_parent().get_node("Visuals/KeelLower/CommDish").get_node("Ping")._rings[0]["color"] == Color(0.710, 0.541, 0.878, 1.0) "the dish finds the Sun and pings in the Titan's purple"
wait_until get_tree().root.get_node("RobotRadio").guide_awake 5
assert get_tree().root.get_node("RobotRadio").current_line().text == "..." "UNIT-7 comes on the comms"
assert get_tree().paused "and the wake-up holds the game"
screenshot core_4_unit7
assert not pt.core().listens() "a running core is on standby no longer"

# --- The port is open now ---
eval get_tree().root.get_node("RobotRadio").silence()
wait 0.5
assert pt.arm().get_port().is_open() "somebody is home"
press action
wait_until pt.visible_ui().has("SpacePortDialogue") 3

# --- It survives a reload, station and all ---
reload
assert main.booted_last_spawn "a powered station boots the ship's computer again"
assert pt.core().started "still running after a reload"
assert pt.arm().out "the arm stays out"
assert get_tree().get_first_node_in_group("station_power").powered "still powered"
assert get_tree().root.get_node("RobotRadio").guide_awake "UNIT-7 still awake"
assert get_tree().get_first_node_in_group("game_state").station_whole() "every piece still home: a lit station is never in pieces"
assert pt.mount("fuel_tank").seated and pt.mount("dorsal_arm").seated "the Mounts come back seated"
assert pt.section("fuel_tank") == null "and no Section is left floating outside a whole station"
quit
