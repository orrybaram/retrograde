# Sonar resonance: holding ACTION pings from the ship wherever it is free to act.
# Docked, the key belongs to the port; in flight it pings; a menu over the game takes it.
# Run: tools/play.sh playtests/sonar.play   (add --headless to skip screenshots)

press enter
wait_until main.current_game_state == 1 and not get_tree().paused 15
eval get_tree().root.get_node("RobotRadio").mark_seen("boost_hint")
eval get_tree().root.get_node("RobotRadio").mark_seen("first_scrap")
eval get_tree().root.get_node("RobotRadio").mark_seen("first_low_fuel")
eval get_tree().root.get_node("RobotRadio").mark_seen("first_cargo_full")
wait_until pt.state_name() == "LandedState" 5
wait 0.5

# Docked: ACTION is the port's key (it opens the dialogue), no ping
down action
wait 0.5
assert not ship.sonar.emitting "no sonar while docked"
up action
wait_until pt.visible_ui().has("SpacePortDialogue") 2
press down
press enter
wait_until pt.visible_ui().is_empty() 2

# Depart and drift, nothing to harvest nearby
hold thrust 1.5
assert pt.state_name() == "FlyingState" "thrust undocks the ship"
wait 2

# In flight: hold ACTION and the rings go out
down action
wait 0.5
assert ship.sonar.emitting "sonar pings in open flight"
assert ship.sonar.ring_count() > 0 "rings are in the air"
assert pt.state_name() == "FlyingState" "pinging alone doesn't change state"
burst sonar 3 0.25
up action
wait 1.2
assert not ship.sonar.emitting "release stops the ping"
assert ship.sonar.ring_count() == 0 "rings in flight fade out"

# A menu over the game takes the key
press m
wait_until pt.node("log_ui").is_on_map() 2
down action
wait 0.5
assert not ship.sonar.emitting "no sonar under the system map"
up action
press m
wait_until pt.visible_ui().is_empty() 2

state
