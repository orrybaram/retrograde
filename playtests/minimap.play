# Minimap markers: cream heading arrow for the ship, station silhouette with a blue
# beacon, shaded planets, scrap chunks, and a derelict ship pinned to the rim as an
# anonymous contact ring — what it is stays a surprise until you get there.
# Run: tools/play.sh playtests/minimap.play   (frames land in .playtest/minimap_*.png)

press enter
wait_until main.current_game_state == 1 and not get_tree().paused 15
# The controls and scrap tutorials pause the game; this scenario isn't about them
eval get_tree().root.get_node("RobotRadio").mark_seen("boost_hint")
eval get_tree().root.get_node("RobotRadio").mark_seen("first_scrap")
eval get_tree().root.get_node("RobotRadio").mark_seen("first_low_fuel")
eval get_tree().root.get_node("RobotRadio").mark_seen("first_cargo_full")
# A new game opens adrift outside SR-7 (docs/OPENING.md §3). This scenario is not about
# the opening: skip it, and start docked at a running station.
eval pt.skip_opening()
wait_until pt.state_name() == "LandedState" 5
wait 0.5
screenshot minimap_1_docked
press action
wait_until pt.visible_ui().has("SpacePortDialogue") 2
press down
press enter
wait_until pt.visible_ui().is_empty() 2
hold thrust 0.4
hold turn_left 0.4
hold thrust 0.8
wait 1
screenshot minimap_2_flying

# A derelict out past the station, then look for it from far away
eval pt.spawn_derelict(Vector2(600, 300))
frames 2
assert pt.derelict_count() == 1 "a derelict is out there"
assert pt.abandoned_ship().hull_only "empty hull salvages like scrap"
assert pt.abandoned_ship().minimap_target is DerelictMinimapTarget "derelict registered on the minimap"
wait 0.5
screenshot minimap_3_abandoned
eval pt.warp_to(ship.global_position + Vector2(-9000, -5000))
eval ship.state_machine.change_state("FlyingState")
wait 0.5
assert pt.abandoned_ship().minimap_target.pins_to_edge() "far derelict stays on the rim"
screenshot minimap_4_derelict_far

# Nav target: blue diamond around a near waypoint, a small bearing arrow on the rim
# for one that hasn't come onto the map yet
eval get_node("/root/NavSystem").track_point(ship.global_position + Vector2(3000, -2500))
wait 0.2
screenshot minimap_5_waypoint_near
eval get_node("/root/NavSystem").track_point(ship.global_position + Vector2(-30000, 8000))
wait 0.2
screenshot minimap_6_waypoint_far
eval get_node("/root/NavSystem").track(null)
