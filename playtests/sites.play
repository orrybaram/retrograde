# Landing sites: hidden until their planet is scanned, then a beacon + pad on the rim
# that rides the orbit, shows on the minimap and becomes the tracked target.
# Run: tools/play.sh playtests/sites.play   (frames land in .playtest/sites_*.png)

press enter
wait_until main.current_game_state == 1 and not get_tree().paused 15
eval get_tree().root.get_node("RobotRadio").mark_seen("first_departure")
eval get_tree().root.get_node("RobotRadio").mark_seen("first_scrap")
wait_until pt.state_name() == "LandedState" 5
press action
wait_until pt.visible_ui().has("SpacePortDialogue") 2
press down
press enter
wait_until pt.visible_ui().is_empty() 2
hold thrust 0.5
wait_until pt.state_name() == "FlyingState" 3

# Skip the store: this scenario is about the sites
eval gs.set("has_planet_scanner", true)
assert pt.planet("Rook").get_landing_sites().size() == 1 "Rook (a moon) has one site"
assert pt.planet("Rook").get_landing_sites()[0].rich "moon sites are rich"
assert not pt.planet("Rook").get_landing_sites()[0].visible "site hidden before the scan"
assert not pt.planet("Rook").get_landing_sites()[0].minimap_target.is_minimap_visible() "not on the minimap before the scan"
eval pt.park_near_planet("Rook", 1900, 8)
wait 0.5
screenshot sites_1_hidden
wait_until gs.is_planet_scanned("Veld/Rook") 6
wait 0.3
screenshot sites_2_reveal
assert pt.planet("Rook").get_landing_sites()[0].visible "site revealed by the scan"
assert pt.planet("Rook").get_landing_sites()[0].minimap_target.is_minimap_visible() "site on the minimap"
assert pt.snapshot().tracking.label == "SITE" "tracker points at the site"
wait_until not pt.node("scan_panel").is_typing() 5
assert pt.node("scan_panel").body_text().contains("1 FOUND") "readout counts the site"
wait 1.5
screenshot sites_3_beacon

# The site rides the orbit with its planet
eval pt.set_meta("site_start", pt.planet("Rook").get_landing_sites()[0].global_position)
wait 2
assert pt.planet("Rook").get_landing_sites()[0].global_position.distance_to(pt.get_meta("site_start")) > 20 "site moves with the orbit"
assert (pt.planet("Rook").get_landing_sites()[0].global_position - pt.planet("Rook").global_position).length() == pt.planet("Rook").radius "site stays on the rim"

# Off screen, the tracking chevron leads back to it
eval pt.park_near_planet("Rook", 3600, 60)
wait 0.5
screenshot sites_4_tracking
assert pt.snapshot().tracking.label == "SITE" "still tracking the site from afar"
state
