# UNIT-7's only call is the wake-up, when SR-7's core catches in Act 1
# (playtests/core_cold_start.play). Every tip, alarm and game-over call is disconnected:
# with the guide awake, running low, filling the hold, finding scrap and losing the ship
# all pass in silence, and a lost ship relaunches with nothing to confirm.
# Run: tools/play.sh playtests/radio.play

press enter
wait_until main.current_game_state == 1 and not get_tree().paused 15
# A new game opens adrift outside SR-7 (docs/OPENING.md §3). This scenario is not about
# the opening: skip it, and start docked at a running station, with the guide awake.
eval pt.skip_opening()
eval get_tree().root.get_node("RobotRadio").set("guide_awake", true)
wait_until pt.state_name() == "LandedState" 5
press action
wait_until pt.visible_ui().has("SpacePortDialogue") 2
press down
press enter
wait_until pt.visible_ui().is_empty() 2
hold thrust 0.6
assert pt.state_name() == "FlyingState" "undocked"
wait 1
assert not pt.node("radio_panel").visible "departure is quiet"

# Low fuel: no call
eval ship.set("fuel", 30.0)
eval ship.consume_fuel(0.1)
wait 1
assert not get_tree().root.get_node("RobotRadio").is_active() "no low-fuel call"
assert not get_tree().paused "nothing pauses"

# Scrap in range: no call
eval ship.set("fuel", 150.0)
stage_harvest 40
wait 1
assert not get_tree().root.get_node("RobotRadio").is_active() "no scrap tip"

# The hold fills: no call
eval inv.add_item("shard", int(ship.max_cargo_weight))
wait 1
assert not get_tree().root.get_node("RobotRadio").is_active() "no hold-full call"

# The hull drops into the red: no call
eval ship.take_damage(85.0)
wait 1
assert not get_tree().root.get_node("RobotRadio").is_active() "no hull alarm"
assert not get_tree().paused "nothing pauses"

# Lost: the next clone comes up on its own
eval ship.take_damage(100000.0)
wait_until main.current_game_state == 2 10
assert not get_tree().root.get_node("RobotRadio").is_active() "no game-over call"
wait_until main.current_game_state == 1 and pt.state_name() == "LandedState" 15
assert not get_tree().paused "the relaunch leaves nothing paused"
assert not pt.node("radio_panel").visible "radio quiet after relaunch"
assert gs.death_count == 1 "the loss still counts"
# Let the dock's save-indicator timer finish so nothing is pending at quit
wait 1
quit
