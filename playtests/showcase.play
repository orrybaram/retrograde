# Planetary Scanner & Landing showcase, captioned, for recording a video:
#   godot --path . --write-movie .playtest/showcase.avi --fixed-fps 30 -- --playtest=res://playtests/showcase.play
# (see also tools/play.sh). Not an assertion suite; see scanner/sites/landing/drill/regrow.play.

press enter
wait_until main.current_game_state == 1 and not get_tree().paused 15
eval get_tree().root.get_node("RobotRadio").mark_seen("first_departure")
eval get_tree().root.get_node("RobotRadio").mark_seen("first_scrap")
eval get_tree().root.get_node("RobotRadio").mark_seen("first_cargo_full")
wait_until pt.state_name() == "LandedState" 20
eval gs.set("credits", 100)
eval pt.caption("PLANETARY SCANNER  //  buy it at the home station")
wait 1.5
press action
wait_until pt.visible_ui().has("SpacePortDialogue") 2
wait 0.6
press enter
wait_until pt.visible_ui().has("StoreUI") 2
wait 0.8
press enter
wait 0.6
press down
wait 0.25
press down
wait 0.25
press down
wait 0.25
press down
wait 1.8
press enter
wait_until gs.has_planet_scanner 3
wait 1.2
press esc
wait 0.3
press esc
wait_until pt.visible_ui().has("SpacePortDialogue") 2
press down
wait 0.4
press enter
wait_until pt.visible_ui().is_empty() 2

eval pt.caption("Unscanned planets read  ? ? ?  on the minimap")
hold thrust 0.6
wait 2.5

eval pt.caption("Hold inside a gravity field to scan  //  leaving resets the meter")
eval pt.park_near_planet("Rook", 2000, 20)
wait 1.6
eval pt.park_near_planet("Rook", 5200, 20)
wait 1.4
eval pt.caption("Stay in the field: the sweep fills the meter")
eval pt.park_near_planet("Rook", 2000, 20)
wait_until gs.is_planet_scanned("Veld/Rook") 6
eval pt.caption("Scan complete  //  survey readout + ore seams surfaced")
wait 3.5

eval pt.caption("Hexagons just under the surface: the ore, tracked and riding the orbit")
eval pt.park_near_planet("Rook", 1900, 8)
wait 2.5

eval pt.caption("Too fast into the ground: hull damage and a bounce")
wait 0.8
eval pt.hover_over_ore("Rook", 40, 0, 110)
wait 3

eval pt.caption("Slow, nose up, on plain ground by the ore: touchdown")
eval pt.park_near_planet("Rook", 2000, 30)
frames 5
eval pt.hover_over_ore("Rook", 70)
land Rook 20 30
wait 1.2
eval pt.caption("Landed: riding the orbit, no fuel burn")
wait 2.5

eval pt.caption("Hold SPACE to drill  //  release in the zone  //  deeper layers, better gems")
wait 1.0
down action
wait_until pt.drill().timing.progress >= pt.drill().timing.perfect_start() 3
up action
wait 1.4
down action
wait_until pt.drill().timing.progress >= pt.drill().timing.zone_start + 0.01 3
up action
wait 1.4
down action
wait_until pt.drill().timing.progress >= pt.drill().timing.perfect_start() 3
up action
wait 1.4
down action
wait_until pt.drill().timing.progress >= pt.drill().timing.perfect_start() 3
up action
wait 1.0
eval pt.caption("Bedrock  //  the seam is spent: its hexes dim")
wait 3.5

eval pt.caption("Liftoff burns fuel: planet gravity x cargo weight")
hold thrust 0.15
wait 2.5

eval pt.caption("A spent seam refuses the drill until it refills")
eval pt.park_near_planet("Rook", 2000, 30)
frames 5
eval pt.hover_over_ore("Rook", 70)
land Rook 20 30
wait 1.0
hold action 1.2
wait 2.0

eval pt.caption("Push your luck: hold too long and the drill kicks back")
eval gs.tick_ore_regrowth(1000)
wait 1.5
down action
wait_until pt.drill().timing.progress >= pt.drill().timing.zone_start + 0.01 3
up action
wait 1.2
down action
wait_until pt.drill().phase == 2 4
up action
wait 3

eval pt.caption("Refills after ~5 min of play (rich moon seams take longer)  //  saved")
eval gs.tick_ore_regrowth(1000)
wait 3.5
eval pt.caption("")
wait 0.5
