# Deep-space encounters: the void between planets is populated, comes back the same way
# every time, and stays stripped once you've harvested it.
# Run: tools/play.sh playtests/encounters.play
#      tools/play.sh --headless playtests/encounters.play  (logic only)
# See docs/ENCOUNTERS.md. DEEP is a point ~78000 from the nearest planet, so everything
# here belongs to EncounterField and not to a planet's own ring spawner.

press enter
wait_until main.current_game_state == 1 and not get_tree().paused 15
# The tutorials pause the game; this scenario isn't about them
eval get_tree().root.get_node("RobotRadio").mark_seen("first_departure")
eval get_tree().root.get_node("RobotRadio").mark_seen("first_scrap")
eval get_tree().root.get_node("RobotRadio").mark_seen("first_low_fuel")
eval get_tree().root.get_node("RobotRadio").mark_seen("first_cargo_full")
wait_until pt.state_name() == "LandedState" 5
# SR-7's dock is shut until its core is cold-started (docs/OPENING.md §5). This
# scenario is not about the opening, so start the core and open the port.
eval gs.set("core_started", true)
press action
wait_until pt.visible_ui().has("SpacePortDialogue") 2
press down
press enter
wait_until pt.visible_ui().is_empty() 2
hold thrust 0.5
wait_until pt.state_name() == "FlyingState" 3

# --- The void is mostly empty, but not entirely ---
# Deep space is sparse on purpose, so `seek` hunts for a populated stretch rather than
# assuming any particular spot holds something.
seek Scrap
eval pt.remember("spot", ship.global_position)
assert pt.nearest("planets").distance > 50000 "this is deep space, not a planet's ring"
assert pt.node("encounter_field").node_count() > 0 "deep space streams in encounters"
assert pt.nearest("resource_nodes").distance < 10000 "there is something within scanner range"
screenshot encounters_01_deep_space

# --- The rings turn, so deep space drifts past ---
# Measured on one node rather than on "whatever is nearest": the ship sits still while
# the ring carries everything around it, so the nearest node can change hands.
eval pt.remember("drifter", pt.nearest_kind("Scrap"))
eval pt.remember("drift_from", pt.recall("drifter").global_position)
eval pt.remember("clock", pt.node("encounter_field").elapsed())
# Real seconds, not scaled ones: the rings run on the same clock as the planets, which
# Engine.time_scale doesn't touch. At this radius that is about 8 px a second.
wait 5
assert pt.node("encounter_field").elapsed() > pt.recall("clock") + 3 "the field keeps its own clock"
assert pt.recall("drifter").global_position.distance_to(pt.recall("drift_from")) > 10 "the rings carry deep space around"
assert pt.node("encounter_field").node_count() > 0 "and it is still populated"

# --- Leaving unloads it, returning brings back the same space ---
# Only the round trip is checked here. That a cell regenerates identically is pinned
# down in EncounterFieldTest, which can hold time still; out here the rings keep turning
# and the ship slides between sectors even sitting perfectly still, so the set of loaded
# cells is not the same set a few seconds later.
eval pt.remember("nearest", pt.nearest("resource_nodes").distance)
eval pt.warp_to(Vector2(-200000, 10000))
wait 1.5
assert pt.node("encounter_field").node_count() >= 0 "the field survives the hop"
eval pt.warp_to(pt.recall("spot"))
wait 1.5
assert pt.node("encounter_field").node_count() > 0 "the space we left is still there on return"
# Within a ring's drift over the couple of seconds the round trip takes
assert abs(pt.nearest("resource_nodes").distance - pt.recall("nearest")) < 250 "and in the same places"

# --- Harvesting deep space strips it for good ---
stage_harvest 40 plain kind:Scrap
assert pt.staged.spawner_key != "" "a deep-space node carries its slot key"
eval pt.remember("slot", pt.staged.spawner_key)
assert pt.staged.hits_left == 3 "normal scrap takes 3 hits"
down action
wait_until pt.staged.timing.progress >= pt.staged.timing.perfect_start() 3
up action
wait_until pt.staged.hits_left == 2 2
down action
wait_until pt.staged.timing.progress >= pt.staged.timing.perfect_start() 3
up action
wait_until pt.staged.hits_left == 1 2
down action
wait_until pt.staged.timing.progress >= pt.staged.timing.perfect_start() 3
up action
wait_until pt.staged._state_machine.get_current_state_name() == "ScrapDepletedState" 2
# The node pops before it reports itself depleted, so the slot lands a beat after the break
wait_until pt.node("encounter_field").consumed_keys().has(pt.recall("slot")) 3
assert pt.node("encounter_field").consumed_keys().has(pt.recall("slot")) "the harvested slot is recorded"
wait_until pt.state_name() == "FlyingState" 3
screenshot encounters_02_harvested

# --- Unlike a planet's ring, the void does not refill ---
eval pt.warp_to(Vector2(-200000, 10000))
wait 1.5
eval pt.warp_to(pt.recall("spot"))
wait 1.5
assert pt.node("encounter_field").consumed_keys().has(pt.recall("slot")) "what you took stays taken"

# An encounter is one contact however many pieces it is made of
assert pt.node("encounter_field").contacts_in_range(ship.global_position, 10000.0).size() <= pt.node("encounter_field").node_count() "contacts never outnumber the pieces they group"

# Close in on the sun there is nothing to find at all
eval pt.warp_to(Vector2(12000, 0))
wait 1
assert pt.node("encounter_field").contacts_in_range(ship.global_position, 10000.0).is_empty() "the sun's own space stays empty"
eval pt.warp_to(pt.recall("spot"))
wait 1.5

# --- Deep space holds more than debris ---
seek Derelict
assert pt.count_kind("Derelict") > 0 "wrecked ships drift out here"
eval pt.remember("wreck_spot", ship.global_position)
eval pt.remember("wrecks_here", get_tree().get_nodes_in_group("derelicts").size())
screenshot encounters_03_wrecks

seek Container
assert pt.count_kind("Container") > 0 "so do sealed containers"

# A container is trophy grade: five clean cuts, and a better class of gem out of each
stage_harvest 40 kind:Container
assert pt.staged.is_trophy "containers always come out trophy grade"
assert pt.staged.hits_left == 5 "a sealed container takes five cuts"
assert pt.staged.spawner_key != "" "and it belongs to the field like anything else"
eval pt.remember("box", pt.staged.spawner_key)
down action
wait_until pt.staged.timing.progress >= pt.staged.timing.perfect_start() 3
up action
wait_until pt.staged.hits_left == 4 2
down action
wait_until pt.staged.timing.progress >= pt.staged.timing.perfect_start() 3
up action
wait_until pt.staged.hits_left == 3 2
down action
wait_until pt.staged.timing.progress >= pt.staged.timing.perfect_start() 3
up action
wait_until pt.staged.hits_left == 2 2
down action
wait_until pt.staged.timing.progress >= pt.staged.timing.perfect_start() 3
up action
wait_until pt.staged.hits_left == 1 2
down action
wait_until pt.staged.timing.progress >= pt.staged.timing.perfect_start() 3
up action
wait_until pt.staged._state_machine.get_current_state_name() == "ScrapDepletedState" 2
wait_until pt.node("encounter_field").consumed_keys().has(pt.recall("box")) 3
assert pt.node("encounter_field").consumed_keys().has(pt.recall("box")) "an opened container stays opened"
wait_until pt.state_name() == "FlyingState" 3

# --- Clone wrecks are rationed, not scattered ---
# Whether one has turned up yet is luck; that it can never exceed its budget is not.
assert pt.node("encounter_field").claimed_count("clone_wreck") <= 3 "clone wrecks never exceed their budget"
eval pt.remember("clones", pt.node("encounter_field").claimed_count("clone_wreck"))

# --- And survives a save and reload ---
eval pt.save_now()
eval main.call_deferred("load_game")
frames 2
wait_until main.current_game_state == 1 and not get_tree().paused 15
wait 1
assert pt.node("encounter_field").consumed_keys().has(pt.recall("slot")) "the save remembers what deep space lost"
assert pt.node("encounter_field").elapsed() > pt.recall("clock") + 3 "and how far its rings had turned"
assert pt.node("encounter_field").claimed_count("clone_wreck") == pt.recall("clones") "clone wrecks stay spoken for"
# Field wrecks are rebuilt from the seed, so the save must not keep a second copy.
# The rings turn as the run goes on, so the window can hold fewer than before — never more.
eval pt.warp_to(pt.recall("wreck_spot"))
wait 1.5
assert get_tree().get_nodes_in_group("derelicts").size() <= pt.recall("wrecks_here") "a reload doesn't leave a duplicate wreck behind"
assert pt.node("encounter_field").consumed_keys().has(pt.recall("box")) "and the opened container is still open"
hold thrust 0.5
wait_until pt.state_name() == "FlyingState" 3
eval pt.warp_to(pt.recall("spot"))
wait 1.5
assert pt.node("encounter_field").consumed_keys().has(pt.recall("slot")) "a reloaded game finds it still stripped"
assert pt.node("encounter_field").node_count() > 0 "and the rest of the stretch is back"

state
