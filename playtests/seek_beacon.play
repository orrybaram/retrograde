# The opening's beacon (SeekBeacon): once PROPULSION clears and before SONAR does, the loose
# Section nearest the ship blinks a running light, with a caret on the screen's edge while it
# is off screen. It goes once a Sweep has found it and SONAR clears.
# Run: PLAYTEST_PORT=7841 tools/play.sh --headless playtests/seek_beacon.play

eval main.set("force_boot_log", true)
press enter
wait_until main.current_game_state == 1 and not get_tree().paused 15
eval pt.remember("log", pt.node("hud").boot_log)
eval pt.remember("beacon", pt.node("hud").get_node("SeekBeacon"))
assert pt.recall("beacon").target() == null "nothing to point at while the header types"

# --- FLIGHT: clear it, well away from the tank so SONAR stays shut ---
wait_until pt.recall("log").checklist.is_live("flight") 6
wait 2.5
assert pt.recall("beacon").target() == null "nor while PROPULSION is still on the stick"
eval pt.warp_to(pt.section("fuel_tank").global_position + (ship.global_position - pt.section("fuel_tank").global_position).normalized() * 900.0)
eval ship.set("linear_velocity", pt.node("space_stations").linear_velocity)
hold thrust 0.5
hold reverse_thrust 0.8
hold turn_left 0.3
hold turn_right 0.3
wait_until pt.recall("log").checklist.is_cleared("flight") 8
wait 0.1
assert pt.recall("beacon").target() != null "PROPULSION cleared: the beacon is lit on a Section"
assert pt.recall("beacon").target().section != "" "a piece of SR-7, not just any Freight"
assert not pt.recall("log").checklist.is_open("sonar") "SONAR is still shut: this is the stretch it covers"

# --- Off screen: the caret ---
eval pt.warp_to(pt.recall("beacon").target().global_position + Vector2(1600, 0))
eval ship.set("linear_velocity", pt.recall("beacon").target().linear_velocity)
wait 0.2
assert not pt.recall("beacon").on_screen() "well away, it is off screen"
screenshot seek_beacon_0_caret

# --- On screen: the light ---
eval pt.warp_to(pt.recall("beacon").target().lug_global() + pt.recall("beacon").target().lug_facing_global() * 120.0)
eval ship.set("linear_velocity", pt.recall("beacon").target().linear_velocity)
wait 0.3
assert pt.recall("beacon").on_screen() "close by, it is on screen"
screenshot seek_beacon_1_light

# --- Sweep it: once SONAR clears the beacon goes ---
eval pt.warp_to(pt.recall("beacon").target().lug_global() + pt.recall("beacon").target().lug_facing_global() * 180.0)
eval ship.set("linear_velocity", pt.recall("beacon").target().linear_velocity)
wait 1.0
hold action 0.1
wait_until pt.recall("log").checklist.is_cleared("sonar") 8
wait 0.1
assert pt.recall("beacon").target() == null "SONAR cleared: the beacon is out"
quit
