# Low-fuel vapor + engine sputter, full-hold HUD (gems left floating), plus omnidirectional harvest range.
# Run: tools/play.sh playtests/alerts.play   (frames land in .playtest/alert_*.png)

press enter
wait_until main.current_game_state == 1 and not get_tree().paused 15
# The controls and scrap tutorials pause the game; this scenario isn't about them
eval get_tree().root.get_node("RobotRadio").mark_seen("boost_hint")
eval get_tree().root.get_node("RobotRadio").mark_seen("first_scrap")
eval get_tree().root.get_node("RobotRadio").mark_seen("first_low_fuel")
eval get_tree().root.get_node("RobotRadio").mark_seen("first_cargo_full")
wait_until pt.state_name() == "LandedState" 5
press action
wait_until pt.visible_ui().has("SpacePortDialogue") 2
press down
press enter
wait_until pt.visible_ui().is_empty() 2
hold thrust 0.5
wait_until pt.state_name() == "FlyingState" 3
assert ship.max_fuel == 150.0 "base tank is 150"
eval ship.set("fuel", 45.0)
wait 0.8
screenshot alert_vapor_low
eval ship.set("fuel", 15.0)
wait 0.3
down thrust
wait_until ship.low_fuel_effect.is_coughing() 3
frames 2
assert ship.thruster_particles.emitting "the cough takes the boost, not the thrust"
assert not ship.boost_particles.emitting "the boost plume is what a cough cuts"
burst alert_sputter 6 0.06
up thrust
eval ship.set("fuel", 150.0)
wait 0.2
assert not ship.low_fuel_effect.is_coughing() "cough clears above threshold"
wait 2.2
assert ship.low_fuel_effect._puffs.is_empty() "vapor dissipates"
eval inv.add_item("shard", int(ship.max_cargo_weight))
wait 0.3
screenshot alert_cargo_full
assert ship.is_cargo_full() "hold is full"
stage_harvest 40
down action
wait_until pt.staged.timing != null and pt.staged.timing.progress >= pt.staged.timing.zone_start 3
up action
wait_until pt.gem_count() > 0 2
wait 1.5
assert pt.gem_count() > 0 "full hold leaves gems floating"
assert pt.item_count() == int(ship.max_cargo_weight) "magnet ignores gems that don't fit"
screenshot alert_cargo_blocked
eval inv.clear_inventory()
stage_harvest 40
eval ship.set("rotation", ship.rotation + PI)
frames 5
assert pt.staged._state_machine.get_current_state_name() == "ScrapInRangeState" "scrap in range while facing away"
quit
