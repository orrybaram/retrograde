# Sweep readouts (docs/SWEEP.md §10): a Sweep that reaches one of SR-7's empty Mounts reads
# it into the HUD's bottom-right corner, a tap one tier deep and a charged ring deeper. Reading
# the Mount is what puts its Section on the minimap; an unread Mount's piece stays off it,
# and a read survives a reload. A Sweep reads only the readout closest to the ship, and what
# was read shimmers; the Log's Records keep a Hardware Record of it, and a Gate - part of the
# Titan - reads back as noise in purple.
# Run: tools/play.sh playtests/readout.play   (add --headless to skip screenshots)

press enter
wait_until main.current_game_state == 1 and not get_tree().paused 15
eval get_tree().root.get_node("RobotRadio").mark_seen("first_departure")
eval get_tree().root.get_node("RobotRadio").mark_seen("first_scrap")
eval get_tree().root.get_node("RobotRadio").mark_seen("first_low_fuel")
eval get_tree().root.get_node("RobotRadio").mark_seen("first_cargo_full")
# A new game, adrift by a dead SR-7: past the diagnostic so the Sweep is the pilot's
eval get_tree().call_group("boot_log", "forget")
eval pt.remember("station", pt.mount("fuel_tank").get_parent())
assert not pt.mount("fuel_tank").marks_section() "an unread Mount marks nothing"
assert not pt.mount("fuel_tank")._minimap_target.is_minimap_visible() "the tank is off the minimap"
assert pt.node("contact_log") != null and not pt.node("contact_log").visible "nothing read yet"

# Out beside the fuel tank's cut, in a tap's reach of it
eval pt.warp_to(pt.recall("station").to_global(Vector2(360, 19)))
eval ship.set("linear_velocity", pt.recall("station").linear_velocity)
wait 0.3
assert ship.global_position.distance_to(pt.mount("fuel_tank").global_position) < 260.0 "in a tap's reach"

screenshot readout_0_unread

# A tap reads tier 1, and the Mount itself shimmers
press action
wait_until pt.node("readout_shimmer").is_shimmering(pt.mount("fuel_tank")) 3
wait_until pt.node("contact_log").text().contains("SECTION") 3
assert pt.node("contact_log").text().begins_with("MOUNT / FUEL TANK") "the Mount's heading"
assert pt.node("contact_log").text().contains("EMPTY") "what state it is in"
assert not pt.node("contact_log").text().contains("TORCH CUT") "a tap reads no deeper"
assert pt.mount("fuel_tank").marks_section() "read, it marks its Section"
assert pt.mount("fuel_tank")._minimap_target.is_minimap_visible() "the tank is on the minimap"
assert not pt.mount("solar_array").marks_section() "the array's Mount was not read"
assert not pt.mount("solar_array")._minimap_target.is_minimap_visible() "the array stays off the minimap"
screenshot readout_1_tap

# A charged ring reads deeper, over the same entry - and still only the closest Mount
down action
wait 3.2
up action
wait_until pt.node("contact_log").text().contains("FRACTURE") 4
assert pt.node("contact_log").text().contains("TORCH CUT") "tier 2"
assert pt.node("contact_log").text().count("FUEL TANK") == 1 "the same Mount's entry, typed over"
assert not pt.mount("solar_array").marks_section() "one read a Sweep: the array's Mount is further"
screenshot readout_2_charged

# It fades on its own
wait 9
assert not pt.node("contact_log").visible "gone once it has held"

# The read is kept
eval pt.save_now()
reload
assert pt.mount("fuel_tank").marks_section() "still marked after a reload"

# The Log keeps a Hardware Record of each, as deep as it was read
press i
wait_until pt.visible_ui().has("LogUI") 2
press tab
assert pt.node("log_ui").active_tab_title() == "RECORDS" "on Records"
assert pt.node("log_ui")._tabs[1]._read.size() == 1 "one Mount read"
assert str(pt.screen_text()).contains("H A R D W A R E") "the Hardware section"
assert str(pt.screen_text()).contains("SR-7") "filed under the station"
assert str(pt.screen_text()).contains("TORCH CUT") "the tank's Record holds what the charged ring read"
screenshot readout_3_records
press i
wait_until pt.visible_ui().is_empty() 2

# A Gate is part of the Titan: read, but nothing in it can be made out
eval pt.park_at_gate("Veld", 120.0)
wait 0.3
press action
wait_until pt.node("readout_shimmer").is_shimmering(pt.gate("Veld")) 3
wait_until pt.node("contact_log").visible 3
wait 1.5
assert not pt.node("contact_log").text().contains("GATE") "no heading to read"
assert not pt.node("contact_log").text().contains("DORMANT") "no state to read"
screenshot readout_4_gate
assert pt.gate("Veld").get_node("SweepReadout").is_read() "read all the same"
press i
wait_until pt.visible_ui().has("LogUI") 2
assert pt.node("log_ui")._tabs[1]._read.size() == 1 "nothing learned from it for the Log"
press i
state
