# Act 1, the repair of SR-7 (docs/OPENING.md §2-4). A new game wakes the ship adrift beside
# a station missing its FUEL TANK, SOLAR ARRAY and DORSAL ARM, with the right solar wing
# hanging off true and its dock's arm run in. The three Sections float dead out in Rook's
# debris on one line; each is fetched, released at its own Mount and seated, and the wing
# is pushed home with the hull. It all survives reloads, and leaves the station whole and
# still dark, its core on standby and its dock's arm out.
# Run: PLAYTEST_PORT=7793 tools/play.sh --headless playtests/restore_sr7.play

press enter
wait_until main.current_game_state == 1 and not get_tree().paused 15
eval get_tree().root.get_node("RobotRadio").mark_seen("first_departure")
eval get_tree().root.get_node("RobotRadio").mark_seen("boost_hint")
eval get_tree().root.get_node("RobotRadio").mark_seen("first_scrap")
eval get_tree().root.get_node("RobotRadio").mark_seen("first_low_fuel")
eval get_tree().root.get_node("RobotRadio").mark_seen("first_cargo_full")

# --- New game: adrift beside the station, no dock, three cut gaps, a hanging wing ---
eval pt.remember("station", pt.mount("fuel_tank").get_parent())
assert pt.state_name() == "FlyingState" "adrift, not docked"
assert ship.global_position.distance_to(pt.recall("station").to_global(Vector2(560, 190))) < 40.0 "just off the end of the belly, where the dock would be"
assert not pt.arm().out and not pt.arm().get_port().accepts_docking() "the dock's arm is in: nowhere to dock"
assert not pt.mount("fuel_tank").seated and not pt.mount("solar_array").seated and not pt.mount("dorsal_arm").seated "all three Mounts empty"
assert not pt.recall("station").get_node("Visuals/FuelTank").visible "the fuel tank is gone"
assert not pt.nudge().seated and absf(pt.nudge().off_true()) > 0.3 "the right wing hangs off true"
# A dead station: no power, the dish hanging, every cut sparking under a red strobe
assert not pt.recall("station").get_node("StationPower").powered "no power on a new game"
assert not pt.recall("station").get_node("Lights").lit "every light out"
assert pt.recall("station").get_node("Visuals/KeelLower/CommDish").limp "the dish hangs limp"
assert pt.mount("fuel_tank").alarm.active and pt.mount("solar_array").alarm.active and pt.mount("dorsal_arm").alarm.active and pt.nudge().alarm.active "an alarm at every cut"
screenshot restore_1_new_game
# Hanging where the dock should be offers nothing to dock at
eval pt.warp_to(pt.recall("station").to_global(Vector2(410, 100)))
eval ship.set("linear_velocity", pt.recall("station").linear_velocity)
frames 5
assert pt._action_message != "DOCK" and not pt._action_message.contains("DOCK") "no DOCK prompt with the arm in"

# --- The Sections: the tank adrift just past the dock, the arm going round in Rook's
# debris with the ring, the array lying on Rook's sunlit ground ---
assert pt.section("fuel_tank").lodged_in == pt.recall("station") "the tank keeps pace with SR-7, not Rook"
assert pt.section("fuel_tank").global_position.distance_to(pt.recall("station").to_global(Vector2(382, 100))) > 1100.0 and pt.section("fuel_tank").global_position.distance_to(pt.recall("station").to_global(Vector2(382, 100))) < 1600.0 "just off screen from where the ship wakes"
assert pt.section("fuel_tank").global_position.x > pt.recall("station").to_global(Vector2(382, 100)).x "off to the right"
assert pt.section("dorsal_arm").lodged_in == pt.planet("Rook") and pt.section("dorsal_arm").lodged_spin > 0.0 "the arm goes round Rook with the debris"
wait_until pt.section("dorsal_arm").lodged_beside != null 3
assert pt.section("dorsal_arm").lodged_beside != null "a piece of scrap goes round beside it"
assert pt.section("dorsal_arm").global_position.distance_to(pt.section("dorsal_arm").lodged_beside.global_position) < 300.0 "close beside it"
eval pt.remember("arm_at", pt.section("dorsal_arm").lodged_offset)
wait 1.0
assert pt.section("dorsal_arm").lodged_offset.angle_to(pt.recall("arm_at")) < 0.0 "and it has moved on round, the ring's way"
assert pt.section("dorsal_arm").global_position.distance_to(pt.section("dorsal_arm").lodged_beside.global_position) < 300.0 "still beside its scrap"
# Harvested, the companion is gone for good: no new one turns up beside the arm
eval pt.section("dorsal_arm").lodged_beside._deplete_resource()
wait 2.5
assert pt.section("dorsal_arm").beside_spent and pt.section("dorsal_arm").lodged_beside == null "harvested scrap is not given back"
assert pt.section("solar_array").lodged_in == pt.planet("Rook") and pt.section("solar_array").lodged_spin == 0.0 "the array lies still on Rook"
assert absf(pt.section("solar_array").global_position.distance_to(pt.planet("Rook").global_position) - 1600.0) < 40.0 "in the ground"
assert (pt.section("solar_array").global_position - pt.planet("Rook").global_position).dot(get_node("/root/VoidZone").sun_position() - pt.planet("Rook").global_position) > 0.0 "on the sunlit face"
assert (pt.section("solar_array").global_position - pt.planet("Rook").global_position).dot(pt.recall("station").global_position - pt.planet("Rook").global_position) < 0.0 "the far side from SR-7"
assert pt.chart_marks().is_empty() "never touched, so never marked"

# --- FUEL TANK: fetch, release at its Mount, seated ---
eval ship.set("rotation", (-pt.section("fuel_tank").lug_facing_global()).angle())
eval pt.warp_to(pt.section("fuel_tank").lug_global() + pt.section("fuel_tank").lug_facing_global() * 26.0)
eval ship.set("linear_velocity", pt.section("fuel_tank").linear_velocity)
wait 0.1
hold action 0.8
wait 0.1
assert pt.state_name() == "CarryingState" "the tank is clamped"
assert get_node("/root/NavSystem").get_target().node == pt.mount("fuel_tank") "clamping it tracks its Mount"
eval pt.stage_at_mount("fuel_tank", Vector2(15, -6), 8.0)
frames 3
assert pt._action_message == "RELEASE" "RELEASE at the tank's cradle"
screenshot restore_2_tank_approach
hold action 1.0
assert pt.mount("fuel_tank").seated "the tank is seated"
wait 0.7
assert pt.recall("station").get_node("Visuals/FuelTank").visible "the tank is back"

# --- SOLAR ARRAY: buried in Rook. A hold couples on, like any clamp; pull back hard and
# it comes a little, then the coupling snaps. The third pull rips it out ---
wait 0.2
assert pt.section("solar_array").is_buried() and pt.section("solar_array").buried_tugs_left == 3 "the array is buried: three pulls"
eval pt.remember("sunk", pt.section("solar_array").lodged_offset.length())
eval ship.set("rotation", (-pt.section("solar_array").lug_facing_global()).angle())
eval pt.warp_to(pt.section("solar_array").lug_global() + pt.section("solar_array").lug_facing_global() * 26.0)
eval ship.set("linear_velocity", pt.section("solar_array").linear_velocity)
wait 0.1
eval pt.remember("rings", ship.sonar.ring_count())
hold action 0.4
wait 1.0
assert ship.sonar.ring_count() == pt.recall("rings") "coupling on sends no Sweep ring, like any clamp"
assert pt._action_message == "" "no prompt while coupled"
assert pt.section("solar_array").buried_tugs_left == 3 "coupled on, the key let go, not pulling: nothing gives"
assert ship.global_position.distance_to(pt.section("solar_array").lug_global()) < 60.0 "still coupled with the key let go"
assert ship.to_global(Vector2(ship.NOSE)).distance_to(pt.section("solar_array").lug_global()) < 4.0 "nose on the Lug, like any clamp"
assert ship.state_machine.current_state._latched "latched on"
hold reverse_thrust 2.0
wait 0.1
assert pt.section("solar_array").buried_tugs_left == 2 "a full pull snaps the coupling"
assert pt.section("solar_array").lodged "still in the ground"
assert pt.section("solar_array").lodged_offset.length() > pt.recall("sunk") + 4.0 "but it came up a little"
assert pt.state_name() == "FlyingState" "and the ship is free"
eval ship.set("rotation", (-pt.section("solar_array").lug_facing_global()).angle())
eval pt.warp_to(pt.section("solar_array").lug_global() + pt.section("solar_array").lug_facing_global() * 26.0)
eval ship.set("linear_velocity", pt.section("solar_array").linear_velocity)
wait 0.1
hold action 0.4
wait 0.2
hold action 0.15
wait 0.1
assert ship.state_machine.current_state._coupled == null "a fresh press lets go of it"
assert ship.sonar.ring_count() == 0 "and letting go sends none either"
hold reverse_thrust 0.5
assert pt.section("solar_array").buried_tugs_left == 2 "and letting go costs no pull"
eval ship.set("rotation", (-pt.section("solar_array").lug_facing_global()).angle())
eval pt.warp_to(pt.section("solar_array").lug_global() + pt.section("solar_array").lug_facing_global() * 26.0)
eval ship.set("linear_velocity", pt.section("solar_array").linear_velocity)
wait 0.1
hold action 0.4
hold reverse_thrust 2.0
wait 0.1
assert pt.section("solar_array").buried_tugs_left == 1 "the second pull"
eval ship.set("rotation", (-pt.section("solar_array").lug_facing_global()).angle())
eval pt.warp_to(pt.section("solar_array").lug_global() + pt.section("solar_array").lug_facing_global() * 26.0)
eval ship.set("linear_velocity", pt.section("solar_array").linear_velocity)
wait 0.1
hold action 0.4
hold reverse_thrust 2.0
wait 0.1
assert not pt.section("solar_array").is_buried() "the third pull rips it out"
assert get_tree().get_nodes_in_group("ground_fx").size() > 0 "the ground bursts where it came out"
wait_until pt.state_name() == "CarryingState" 3
assert pt.state_name() == "CarryingState" "and the magnet takes it"
eval pt.stage_at_mount("solar_array", Vector2(-20, 5), -10.0)
frames 3
assert pt._action_message == "RELEASE" "RELEASE at the keel"
hold action 1.0
assert pt.mount("solar_array").seated "the array is seated"
wait 0.7
assert not pt.mount("solar_array").alarm.active "its alarm stops once it is home"
assert not pt.recall("station").get_node("StationPower").powered "one wing is not enough power"

# --- DORSAL ARM, lowered nose-first onto its plate ---
wait 0.2
eval ship.set("rotation", (-pt.section("dorsal_arm").lug_facing_global()).angle())
eval pt.warp_to(pt.section("dorsal_arm").lug_global() + pt.section("dorsal_arm").lug_facing_global() * 26.0)
eval ship.set("linear_velocity", pt.section("dorsal_arm").linear_velocity)
wait 0.1
hold action 0.8
wait 0.1
assert pt.state_name() == "CarryingState" "the arm is clamped"
eval pt.stage_at_mount("dorsal_arm", Vector2(-14, 8), 6.0)
frames 3
assert pt._action_message == "RELEASE" "RELEASE on the fin plate"
hold action 1.0
assert pt.mount("dorsal_arm").seated "the arm is seated"
wait 0.7
assert pt.section("fuel_tank") == null and pt.section("solar_array") == null and pt.section("dorsal_arm") == null "no Section left as Freight"

# --- The hanging wing: pushed home with the hull ---
eval pt.stage_nudge()
wait 0.1
eval pt.remember("off", absf(pt.nudge().off_true()))
hold thrust 2.5
wait_until pt.nudge().seated 3
assert pt.nudge().seated "the wing locked true"
wait 0.5
assert absf(pt.nudge().off_true()) < 0.01 "and it sits true"
assert not pt.nudge().alarm.active "the hinge stops sparking"
# Whole, and still dark: the power comes from the core (playtests/core_cold_start.play)
assert not pt.recall("station").get_node("StationPower").powered "every piece home, and still no power"
assert not pt.recall("station").get_node("Lights").lit "every light still out"
assert pt.recall("station").get_node("Visuals/KeelLower/CommDish").limp "the dish still hangs"
assert pt.core().listens() "the core is on standby"
wait_until pt.arm().out 10
assert pt.arm().get_port().accepts_docking() "and on its battery the dock's arm has run out"
screenshot restore_3_whole

# --- Seated survives reload ---
reload
assert pt.mount("fuel_tank").seated and pt.mount("solar_array").seated and pt.mount("dorsal_arm").seated "all three still seated"
assert pt.nudge().seated and absf(pt.nudge().off_true()) < 0.01 "the wing still true"
assert pt.core().listens() "the core still on standby after a reload"
assert pt.arm().out "the arm still out"
assert get_tree().get_nodes_in_group("ground_fx").is_empty() "the scar in Rook's ground doesn't outlive the session"
assert pt.section("fuel_tank") == null and pt.section("dorsal_arm") == null "no Section comes back as Freight"
eval pt.redock()
wait_until pt.visible_ui().has("CoreTerminal") 3
assert pt.state_name() == "LandedState" "docks at the head of the boom"
assert not pt.arm().get_port().is_open() "nobody runs the port yet: the station's console answers (playtests/core_cold_start.play)"
quit
