# Drilling an ore seam: land over Rook's (rich, 4 layers), hold/release `action` per
# layer, gems fly into the hold; bank between layers; overload kicks back.
# Run: tools/play.sh playtests/drill.play   (frames land in .playtest/drill_*.png)
# The transcript logs drill_struck {grade, gems, layer, final} and dig_ended {reason, layers}.

press enter
wait_until main.current_game_state == 1 and not get_tree().paused 15
eval get_tree().root.get_node("RobotRadio").mark_seen("boost_hint")
eval get_tree().root.get_node("RobotRadio").mark_seen("first_scrap")
eval get_tree().root.get_node("RobotRadio").mark_seen("first_cargo_full")
wait_until pt.state_name() == "LandedState" 5
press action
wait_until pt.visible_ui().has("SpacePortDialogue") 2
press down
press enter
wait_until pt.visible_ui().is_empty() 2
hold thrust 0.5
wait_until pt.state_name() == "FlyingState" 3
eval gs.set("has_planet_scanner", true)
eval pt.park_near_planet("Rook", 2000, 30)
wait_until gs.is_planet_scanned("Veld/Rook") 6
eval pt.hover_over_ore("Rook", 60)
land Rook 15 15
wait 0.5
assert str(pt.snapshot().action_message).contains("DRILL") "landed prompt offers the drill"

# --- A: four PERFECT layers dig to bedrock; the gems reach the hold ---
assert pt.drill().layer_count() == 4 "rich seam digs 4 layers"
down action
wait_until pt.drill().timing.progress >= pt.drill().timing.perfect_start() 3
screenshot drill_a_sweep
up action
wait_until pt.drill().layer == 1 2
assert pt.last_drops.size() >= 3 "perfect layer drops 3+ gems"
burst drill_a_layer 5 0.1
assert str(pt.snapshot().action_message).contains("DRILL 2/4") and str(pt.snapshot().action_message).contains("BANK") "between layers: drill deeper or bank"
down action
wait_until pt.drill().timing.progress >= pt.drill().timing.perfect_start() 3
up action
wait_until pt.drill().layer == 2 2
down action
wait_until pt.drill().timing.progress >= pt.drill().timing.perfect_start() 3
up action
wait_until pt.drill().layer == 3 2
down action
wait_until pt.drill().timing.progress >= pt.drill().timing.perfect_start() 3
up action
wait_until pt.drill().phase == 2 2
assert pt.drill().end_reason == "bottom" "dug to bedrock"
burst drill_a_bedrock 6 0.1
wait_until pt.item_count() == pt.drill().dug.size() or inv.get_total_weight() >= ship.max_cargo_weight 8
assert pt.state_name() == "PlanetLandedState" "still landed after the dig"
assert str(pt.snapshot().action_message).contains("SEAM DRILLED OUT") "dig complete prompt"
screenshot drill_a_done
wait_until pt.popup_counts() == inv.get_all_items() 3

# --- B: bank after one layer ---
hold thrust 0.1
wait_until pt.state_name() == "FlyingState" 2
eval pt.park_near_planet("Rook", 2000, 30)
# The last dig spent the seam; skip its refill time (see regrow.play)
eval gs.tick_ore_regrowth(1000)
frames 5
eval pt.hover_over_ore("Rook", 60)
land Rook 15 15
eval pt.set_meta("held", pt.item_count())
down action
wait_until pt.drill().timing.progress >= pt.drill().timing.zone_start 3
up action
wait_until pt.drill().layer == 1 2
hold reverse_thrust 0.1
wait_until pt.drill().phase == 2 1
assert pt.drill().end_reason == "bank" "banked after one layer"
wait_until pt.item_count() == pt.get_meta("held") + pt.drill().dug.size() or inv.get_total_weight() >= ship.max_cargo_weight 8
assert pt.state_name() == "PlanetLandedState" "banking doesn't lift off"

# --- C: overload ends the dig with kickback ---
hold thrust 0.1
wait_until pt.state_name() == "FlyingState" 2
eval pt.park_near_planet("Rook", 2000, 30)
# The last dig spent the seam; skip its refill time (see regrow.play)
eval gs.tick_ore_regrowth(1000)
frames 5
eval pt.hover_over_ore("Rook", 60)
land Rook 15 15
eval ship.set("hull_strength", ship.max_hull)
down action
wait_until pt.drill().timing.progress >= pt.drill().timing.zone_start 3
up action
wait_until pt.drill().layer == 1 2
down action
wait_until pt.drill().phase == 2 4
up action
assert pt.drill().end_reason == "overload" "held too long"
assert ship.hull_strength == ship.max_hull - 8 "drill kickback damage"
assert pt.drill().layer == 1 "kept the layer already dug"
burst drill_c_kickback 4 0.1
state
