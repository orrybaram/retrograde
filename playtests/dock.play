# Docking at a port: gems fly out of the hold into the port while the HUD Stores count
# rolls up, and SR-7 tops the tank up to its free quarter (~1.25s from empty) and stops
# there (docs/OPENING.md §9). Dialogue opens after the Deposit.
# Run: tools/play.sh playtests/dock.play   (frames land in .playtest/dock_*.png)

press enter
wait_until main.current_game_state == 1 and not get_tree().paused 15
# The controls and scrap tutorials pause the game; this scenario isn't about them
eval get_tree().root.get_node("RobotRadio").mark_seen("boost_hint")
eval get_tree().root.get_node("RobotRadio").mark_seen("first_scrap")
eval get_tree().root.get_node("RobotRadio").mark_seen("first_low_fuel")
eval get_tree().root.get_node("RobotRadio").mark_seen("first_cargo_full")
# A new game opens adrift outside SR-7 (docs/OPENING.md §3). This scenario is not about
# the opening: skip it, and start docked at a running station.
eval pt.skip_opening()
wait_until pt.state_name() == "LandedState" 5
press action
wait_until pt.visible_ui().has("SpacePortDialogue") 2
press down
press enter
wait_until pt.visible_ui().is_empty() 2
hold thrust 0.4
wait_until pt.state_name() == "FlyingState" 3

# Full-ish hold, empty tank, then redock
eval inv.add_item("shard", 30)
eval inv.add_item("gem", 12)
eval inv.add_item("crystal", 4)
eval inv.add_item("artifact", 2)
eval ship.set("fuel", 0.0)
assert gs.stores == 0 "no Stores yet"
# The hold emptying and the Stores rolling up both change how many digits the cargo row
# carries; the meters must not stretch with it
eval pt.remember("fuel_bar_w", pt.node("hud").get_node("DashboardAnchor/HBox/RightColumn/FuelRow/FuelProgressBar").size.x)
eval ship.set_meta("pending_dockable", pt.node("space_ports"))
eval ship.state_machine.change_state("LandedState")
wait 0.9
burst dock_1_deposit 6 0.05
wait_until gs.stores > 0 2
assert inv.get_total_value() > 0 "hold still draining while Stores count up"
assert ship.fuel > 0.0 "tank refilling"
assert not pt.visible_ui().has("SpacePortDialogue") "dialogue waits for the Deposit"
wait 0.8
screenshot dock_2_deposit
wait_until inv.get_total_value() == 0 and gs.stores == 60 + 96 + 100 + 200 3
wait_until pt.visible_ui().has("SpacePortDialogue") 2
wait 0.5
screenshot dock_3_banked
assert pt.node("hud").get_node("DashboardAnchor/HBox/RightColumn/FuelRow/FuelProgressBar").size.x == pt.recall("fuel_bar_w") "fuel meter keeps its width through the Deposit"
assert is_equal_approx(ship.fuel, ship.max_fuel * 0.25) "a quarter tank, and no more"
wait 1.0
assert is_equal_approx(ship.fuel, ship.max_fuel * 0.25) "the fill stopped at the quarter"
assert pt.node("hud").get_node("DashboardAnchor/HBox/RightColumn/FuelRow/FuelProgressBar").size.x == pt.recall("fuel_bar_w") "fuel meter keeps its width once the fill stops"
screenshot dock_4_quarter

# Redocking above the quarter leaves the tank as it was
press escape
wait_until pt.visible_ui().is_empty() 2
hold thrust 0.4
wait_until pt.state_name() == "FlyingState" 3
eval ship.set("fuel", ship.max_fuel * 0.6)
eval ship.set_meta("pending_dockable", pt.node("space_ports"))
eval ship.state_machine.change_state("LandedState")
wait 1.5
assert is_equal_approx(ship.fuel, ship.max_fuel * 0.6) "above the quarter SR-7 adds nothing"
state
