# Seating a Section (docs/adr/0012, docs/OPENING.md §2): a new game has Tower1 missing
# from SR-7 and MAST 1 floating dead just outside the station. Fetch it, and clamping it
# tracks its Mount. A bad approach bounces off the station and never hurts the hull; let
# go outside tolerance it just floats, still clampable. Within tolerance the prompt reads
# RELEASE, and letting go seats it: the Mount pulls it home, the Freight is gone, Tower1 is
# back - and it stays seated across reloads.
# Run: PLAYTEST_PORT=7792 tools/play.sh --headless playtests/seat_mast.play

press enter
wait_until main.current_game_state == 1 and not get_tree().paused 15
eval get_tree().root.get_node("RobotRadio").mark_seen("first_departure")
eval get_tree().root.get_node("RobotRadio").mark_seen("boost_hint")
eval get_tree().root.get_node("RobotRadio").mark_seen("first_scrap")
eval get_tree().root.get_node("RobotRadio").mark_seen("first_low_fuel")
eval get_tree().root.get_node("RobotRadio").mark_seen("first_cargo_full")
wait_until pt.state_name() == "LandedState" 5

# --- New game: the tear, and MAST 1 floating beside the station ---
eval pt.remember("tower", pt.mount("mast_1").get_parent().get_node("Visuals/Tower1"))
assert not pt.mount("mast_1").seated "the Mount is empty"
assert not pt.recall("tower").visible "Tower1 is missing from SR-7"
assert pt.section("mast_1") != null "MAST 1 exists as Freight"
assert pt.section("mast_1").lodged and not pt.section("mast_1").handled "floating dead, never touched"
assert pt.section("mast_1").global_position.distance_to(pt.mount("mast_1").get_parent().global_position) < 800.0 "just outside the station"
assert pt.chart_marks().is_empty() "never touched, so never marked"
eval pt.save_now()

# It keeps pace with the station as the station moves on
eval pt.remember("offset", pt.section("mast_1").global_position - pt.mount("mast_1").get_parent().global_position)
wait 2
assert (pt.section("mast_1").global_position - pt.mount("mast_1").get_parent().global_position).distance_to(pt.recall("offset")) < 5.0 "still hanging where it was beside the station"

# --- Fetch it: nose to the Lug, hold action ---
hold thrust 1.5
assert pt.state_name() == "FlyingState" "thrust undocks the ship"
eval ship.set("rotation", pt.section("mast_1").global_rotation)
eval pt.warp_to(pt.section("mast_1").lug_global() + pt.section("mast_1").lug_facing_global() * 26.0)
eval ship.set("linear_velocity", pt.section("mast_1").linear_velocity)
wait 0.1
hold action 1.5
wait 0.1
assert pt.state_name() == "CarryingState" "MAST 1 clamped"
assert ship.is_carrying() and ship.freight.section == "mast_1" "the load is MAST 1"
assert get_node("/root/NavSystem").get_target().node == pt.mount("mast_1") "clamping MAST 1 tracks its Mount"
assert get_node("/root/NavSystem").get_target().get_label() == "MOUNT" "labelled MOUNT"
eval pt.remember("hull", ship.hull_strength)

# --- A bad approach: the load rams the core, bounces, and the hull is untouched ---
eval pt.stage_at_mount("mast_1", Vector2(-172, 90))
eval ship.set("linear_velocity", pt.mount("mast_1").get_parent().linear_velocity + Vector2(160, 0))
wait 1.0
assert (ship.linear_velocity - pt.mount("mast_1").get_parent().linear_velocity).x < 80.0 "the load hit the core and the ship bounced"
assert ship.hull_strength == pt.recall("hull") "a knock on the load never reaches the hull"
assert pt.state_name() == "CarryingState" "and it is still clamped"
assert not pt.mount("mast_1").seated "nothing seats on a bump"

# --- Released outside tolerance: it floats, still clampable ---
eval pt.stage_at_mount("mast_1", Vector2(-90, 0))
frames 3
assert pt._action_message == "" "no RELEASE prompt out of tolerance"
hold action 1.0
wait 0.1
assert pt.state_name() == "FlyingState" "let go"
assert pt.section("mast_1") != null and pt.section("mast_1").is_loose() "MAST 1 floats free"
assert not pt.mount("mast_1").seated and not pt.recall("tower").visible "the Mount is still empty"
assert get_node("/root/NavSystem").get_target().node == pt.section("mast_1") "the dropped Section is tracked"
eval ship.set("rotation", pt.section("mast_1").global_rotation)
eval pt.warp_to(pt.section("mast_1").lug_global() + pt.section("mast_1").lug_facing_global() * 26.0)
eval ship.set("linear_velocity", pt.section("mast_1").linear_velocity)
wait 0.1
hold action 1.5
wait 0.1
assert pt.state_name() == "CarryingState" "clamped again"

# --- Within tolerance: RELEASE, and the Mount pulls it home (pushed in from the right,
# end for end - a strut has no front) ---
eval pt.stage_at_mount("mast_1", Vector2(25, 6), 192.0)
frames 3
assert pt._action_message == "RELEASE" "the prompt reads RELEASE at the Mount"
screenshot seat_mast_approach
hold action 1.0
assert pt.state_name() == "FlyingState" "let go"
assert pt.mount("mast_1").seated "seated"
assert pt.section("mast_1") == null "no longer Freight"
wait 0.7
assert pt.recall("tower").visible "Tower1 is back"
assert ship.hull_strength == pt.recall("hull") "no damage"
assert get_node("/root/NavSystem").is_tracking_home() "delivered: tracking home"
assert pt.chart_marks().is_empty() "no mark left behind"
screenshot seat_mast_seated

# --- Seated survives reload (written the moment it seated, no dock needed) ---
reload
assert pt.mount("mast_1").seated "still seated after reload"
assert pt.recall("tower").visible "Tower1 still there"
assert pt.section("mast_1") == null "MAST 1 does not come back as Freight"
reload
assert pt.mount("mast_1").seated and pt.section("mast_1") == null "and after another"
quit
